{
  "compilerOptions": {
    "target": "es2019",
    "module": "es2020",
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "../chat-frontend",
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "types": ["node", "dom-speech-recognition", "dompurify", "html-escaper"],
    "plugins": [
      {
        "name": "ts-lit-plugin",
        "strict": true
      }
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "../chat-frontend",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
